# AWS Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# AWS Credentials (Required)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-west-2

# AWS Resources (Replace with your actual values)
AWS_ACCOUNT_ID=your_account_id_here
AWS_KNOWLEDGE_BASE_ID=your_knowledge_base_id_here

# RAG Configuration
RAG_ENABLED=true
RAG_MODE=hybrid
PREFER_AWS_RAG=true

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Optional: S3 Bucket for documents
DOCUMENTS_BUCKET_NAME=your_bucket_name_here

# Optional: OpenSearch Collection
OPENSEARCH_COLLECTION_ARN=arn:aws:aoss:us-west-2:YOUR_ACCOUNT_ID:collection/your_collection_name

# Optional: Bedrock Model Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0